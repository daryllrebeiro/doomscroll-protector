{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "alarms", "commands", "notifications"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://*.reddit.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "__MSG_commandToggle__"
    },
    "open-settings": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_commandSettings__"
    },
    "quick-snooze": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "__MSG_commandSnooze__"
    }
  },
  "action": {
    "default_title": "Mindful Scroll",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://*.reddit.com/*",
        "https://*.youtube.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/content/sites/index.js",
        "src/content/sites/twitter.js",
        "src/content/sites/reddit.js",
        "src/content/sites/youtube.js",
        "src/content/sites/instagram.js",
        "src/content/detector.js",
        "src/content/contentScript.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/overlay.css"],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://*.reddit.com/*",
        "https://*.youtube.com/*",
        "https://*.instagram.com/*"
      ]
    }
  ]
}
